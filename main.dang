type Node {
  """
  The source directory for the project.
  """
  pub source: Directory!

  """
  The base image to use. Defaults to an image suitable for the selected package manager.
  """
  let baseImageAddressOverride: String

  """
  The package manager to use. Defaults to package.json's packageManager field, or npm.
  """
  let packageManagerOverride: String

  new(
    source: Directory! @defaultPath(path: "/") @ignorePatterns(patterns: ["**/node_modules", "/dist", "/build"]),
    baseImageAddress: String = null,
    packageManager: String = null,
  ) {
    self.source = source
    self.baseImageAddressOverride = baseImageAddress
    self.packageManagerOverride = packageManager
    self
  }

  """
  The package manager to use.
  """
  pub packageManager: String! {
    packageManagerName(packageManagerSpec)
  }

  """
  The base image to use.
  """
  pub baseImageAddress: String! {
    if (baseImageAddressOverride != null) {
      baseImageAddressOverride
    } else {
      defaultBaseImageAddress(packageManagerSpec)
    }
  }

  let packageManagerSpec: String! {
    if (packageManagerOverride != null) {
      packageManagerOverride
    } else {
      let packageJSON = source.file("package.json").asJSON
      if (("\n" + packageJSON.fields.join("\n") + "\n").contains("\npackageManager\n")) {
        packageJSON.field(["packageManager"]).asString
      } else {
        "npm"
      }
    }
  }

  let packageManagerName(spec: String!): String! {
    if (spec == "npm" or spec.trimPrefix("npm@") != spec) {
      "npm"
    } else if (spec == "bun" or spec.trimPrefix("bun@") != spec) {
      "bun"
    } else if (spec == "pnpm" or spec.trimPrefix("pnpm@") != spec) {
      "pnpm"
    } else if (spec == "yarn" or spec.trimPrefix("yarn@") != spec) {
      "yarn"
    } else {
      raise `invalid packageManager ${spec}`
    }
  }

  let defaultBaseImageAddress(spec: String!): String! {
    if (spec == "bun") {
      "oven/bun:1.2.4-alpine"
    } else if (spec.trimPrefix("bun@") != spec) {
      "oven/bun:" + spec.trimPrefix("bun@") + "-alpine"
    } else {
      "node:25-alpine"
    }
  }

  """
  Install all required packages
  """
  pub withInstallAll(ctr: Container!): Container! {
    ctr.withExec([packageManager, "install"])
  }

  """
  Install a specific package
  """
  pub withInstallPackage(ctr: Container!, package: String!): Container! {
    let installPackage = [packageManager, "install", package]
    # yarn uses add instead of install
    if (packageManager == "yarn") {
      installPackage = [packageManager, "add", package]
    }

    ctr.withExec(installPackage)
  }

  """
  Install a local package from a Directory
  """
  pub withInstallLocalPackage(ctr: Container!, package: Directory!): Container! {
    let name = "/" + package.digest
    # install the local package
    let installPackage = [packageManager, "install", "-D", name]
    # yarn uses add instead of install
    if (packageManager == "yarn") {
      installPackage = [packageManager, "add", "--dev", name]
    }

    # pnpm needs -w
    if (packageManager == "pnpm") {
      installPackage = [packageManager, "install", "-w", "-D", name]
    }

    ctr.withMountedDirectory(name, package).withExec(installPackage)
  }

  """
  Runtime container for node
  """
  pub base: Container! {
    # set cache variables for all supported package managers
    let base = container.from(baseImageAddress).
      withMountedCache("/root/.packages", cacheVolume("node-toolchain-packages")).
      withEnvVariable("npm_config_cache", "/root/.packages").
      withEnvVariable("YARN_CACHE_FOLDER", "/root/.packages").
      withEnvVariable("PNPM_HOME", "/root/.packages").
      withEnvVariable("BUN_INSTALL_CACHE_DIR", "/root/.packages")

    if (packageManager == "pnpm" and baseImageAddress.contains("node:")) {
      base = base.withExec(["corepack", "enable"])
    }

    base.
      withDirectory("/src", source).
      withWorkdir("/src").
      withEnvVariable("CI", "true").
      withExec([packageManager, "install"])
  }

  """
  Executes an npm package via npx, bunx, etc.
  """
  pub exec(args: [String!]!, from: Container): Container! {
    let ctr = if (from == null) {
      base()
    } else {
      from
    }
    let x = if (packageManager == "npm" or packageManager == "bun") {
      "x"
    } else if (packageManager == "pnpm" or packageManager == "yarn") {
      "dlx"
    } else {
      raise `invalid packageManager ${packageManager}`
    }
    ctr.withExec([packageManager, x] + args)
  }
}
